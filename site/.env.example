# Payments stay off (tests and analytics free) until both of these are set.
# PUBLIC_PAYMENTS_FROM: the first day the paywall applies, as YYYY-MM-DD in
#   India time. Before that day pages show a "from [date]" notice.
# PUBLIC_RAZORPAY_KEY_ID: the Razorpay Key ID (public; never the key secret).
#   rzp_live_... sells real passes; rzp_test_... is ignored unless
#   PUBLIC_PAYMENTS_ALLOW_TEST=1.
# PUBLIC_PAYMENTS_ALLOW_TEST: set to 1 only in local or preview builds, to
#   let a rzp_test_ key switch payments on in test mode.
