---
import Document from './Document.astro';
import Masthead from '../components/Masthead.astro';
import Colophon from '../components/Colophon.astro';

const { title, description, heading, standfirst, crumbs = [], noindex = false } = Astro.props;
---

<Document title={title} description={description} noindex={noindex} breadcrumbs={crumbs}>
  <Masthead crumbs={crumbs} />
  <main class="sheet listing">
    <div class="listing-head">
      <h1>{heading}</h1>
      {standfirst && <p class="standfirst">{standfirst}</p>}
      <slot name="meta" />
    </div>
    <slot />
  </main>
  <Colophon />
</Document>

<style>
  .listing {
    padding-block: clamp(1.5rem, 4vw, 2.75rem);
  }

  .listing-head {
    border-bottom: var(--rule-heavy) solid var(--rule-strong);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  .standfirst {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
    font-size: 1.02rem;
  }
</style>
