---
import Document from '../../layouts/Document.astro';
import Masthead from '../../components/Masthead.astro';
import Colophon from '../../components/Colophon.astro';
import { SUBJECTS, YEARS, CORPUS } from '../../lib/corpus.js';

const API_BASE = process.env.PUBLIC_API_BASE || 'https://upsc-pyq-search-api.onrender.com';

const description = `Search ${CORPUS.total.toLocaleString('en-IN')} UPSC Prelims questions by concept, not just keywords. Free, no sign-up.`;
const crumbs = [{ name: 'Search', href: '/upsc/search' }];
---

<Document title="Search UPSC Prelims Questions" description={description} noindex={true} breadcrumbs={crumbs}>
  <Masthead crumbs={crumbs} />

  <main class="sheet searchpage">
    <div class="listing-head">
      <h1>Search</h1>
      <p class="standfirst">
        Describe an idea in your own words — you get questions about it, including ones
        phrased nothing like your search.
      </p>
    </div>

    <form id="sform" class="sform" role="search" data-api-base={API_BASE}>
      <div class="sform-row">
        <label class="field-label" for="q">Topic or concept</label>
        <div class="sform-input">
          <input id="q" name="q" type="search" autocomplete="off" placeholder="e.g. El Nino and the monsoon" />
          <button type="submit">Search</button>
        </div>
      </div>

      <div class="sform-filters">
        <label>
          <span class="field-label">Subject</span>
          <select id="subject" name="subject">
            <option value="">All subjects</option>
            {SUBJECTS.map((s) => <option value={s.name}>{s.name}</option>)}
          </select>
        </label>
        <label>
          <span class="field-label">From</span>
          <select id="min_year" name="min_year">
            {YEARS.slice().reverse().map((y) => <option value={y.year}>{y.year}</option>)}
          </select>
        </label>
        <label>
          <span class="field-label">To</span>
          <select id="max_year" name="max_year">
            {YEARS.map((y) => <option value={y.year}>{y.year}</option>)}
          </select>
        </label>
        <label>
          <span class="field-label">Difficulty</span>
          <select id="difficulty" name="difficulty">
            <option value="">Any</option>
            <option value="easy">Easy</option>
            <option value="moderate">Moderate</option>
            <option value="difficult">Difficult</option>
          </select>
        </label>
      </div>
    </form>

    <div id="status" class="status" role="status" aria-live="polite"></div>
    <div id="results" class="qlist"></div>
    <nav id="pager" class="pager" aria-label="Pagination"></nav>
  </main>

  <Colophon />
</Document>

{/*
  Wake the search server as the page opens, while the student is still typing:
  on the free plan it sleeps when idle, and warms its model on wake. This is the
  one inline script left, and it stays inline on purpose: a bundled module only
  runs once everything it imports has downloaded, and the ping should not wait
  behind that. Everything else is in the bundled script below, which reads the
  same address from the form's data-api-base.
*/}
<script define:vars={{ API_BASE }}>
  fetch(`${API_BASE}/api/meta`).catch(() => {});
</script>

<script>
  // marks.js and the renderer are imported here, in the one bundled script, so
  // there is a single instance of marks.js: its MutationObserver then fills the
  // empty .qmarks slot of every block run() renders.
  import '../../scripts/marks.js';
  import { esc, questionHTML } from '../../lib/question-html.js';

  const PAGE_SIZE = 25;
  const $ = (id) => document.getElementById(id);
  const form = $('sform');
  const API_BASE = form.dataset.apiBase;
  const statusEl = $('status');
  const resultsEl = $('results');
  const pagerEl = $('pager');

  function pagerHTML(offset, total) {
    const current = Math.floor(offset / PAGE_SIZE) + 1;
    const last = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (last <= 1) return '';

    const want = new Set([1, last, current]);
    for (let i = current - 2; i <= current + 2; i += 1) if (i >= 1 && i <= last) want.add(i);
    const nums = [...want].sort((a, b) => a - b);

    let items = '';
    nums.forEach((n, i) => {
      if (i > 0 && n - nums[i - 1] > 1) items += '<li class="pager-gap" aria-hidden="true">…</li>';
      items +=
        n === current
          ? `<li><span class="pager-n is-current serial" aria-current="page">${n}</span></li>`
          : `<li><button class="pager-n serial" data-page="${n}">${n}</button></li>`;
    });

    const from = offset + 1;
    const to = Math.min(offset + PAGE_SIZE, total);

    return `<p class="pager-count serial">Showing ${from.toLocaleString('en-IN')}–${to.toLocaleString('en-IN')} of ${total.toLocaleString('en-IN')}</p>
      <ul class="pager-list">
        <li>${current > 1 ? `<button class="pager-step" data-page="${current - 1}">Previous</button>` : '<span class="pager-step is-off" aria-disabled="true">Previous</span>'}</li>
        ${items}
        <li>${current < last ? `<button class="pager-step" data-page="${current + 1}">Next</button>` : '<span class="pager-step is-off" aria-disabled="true">Next</span>'}</li>
      </ul>`;
  }

  function readForm() {
    return {
      q: $('q').value.trim(),
      subject: $('subject').value,
      min_year: $('min_year').value,
      max_year: $('max_year').value,
      difficulty: $('difficulty').value,
    };
  }

  function writeUrl(params, offset) {
    const u = new URLSearchParams();
    Object.entries(params).forEach(([k, v]) => v && u.set(k, v));
    if (offset) u.set('offset', offset);
    history.replaceState(null, '', u.toString() ? `?${u}` : location.pathname);
  }

  let inFlight = 0;

  async function run(offset = 0, push = true) {
    const params = readForm();
    if (push) writeUrl(params, offset);

    const ticket = ++inFlight;
    statusEl.textContent = 'Searching…';
    pagerEl.innerHTML = '';
    // A search normally answers in a second or two. Much longer means the free
    // server was asleep: say so, rather than leave "Searching…" looking stuck.
    const slow = setTimeout(() => {
      if (ticket === inFlight) {
        statusEl.textContent =
          'Waking the search server. The first search after a quiet spell can take up to a minute.';
      }
    }, 4000);

    const url = new URL(`${API_BASE}/api/search`);
    Object.entries(params).forEach(([k, v]) => v && url.searchParams.set(k, v));
    url.searchParams.set('top', PAGE_SIZE);
    url.searchParams.set('offset', offset);

    try {
      const res = await fetch(url);
      const data = await res.json().catch(() => null);
      if (ticket !== inFlight) return; // a newer search already replaced this one
      if (!res.ok) {
        const detail = data?.detail ?? data?.error;
        throw new Error(typeof detail === 'string' ? detail : `${res.status} ${res.statusText}`);
      }

      const total = data.total_results ?? data.total_filtered ?? data.results.length;
      if (!data.results.length) {
        statusEl.textContent = 'No questions match those filters.';
        resultsEl.innerHTML = '';
        return;
      }

      statusEl.textContent = '';
      resultsEl.innerHTML = data.results.map(questionHTML).join('');
      pagerEl.innerHTML = pagerHTML(offset, total);
      if (offset > 0) resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      if (ticket !== inFlight) return;
      resultsEl.innerHTML = '';
      statusEl.innerHTML = `Search is unavailable right now (${esc(err.message)}). The question bank is still browsable by <a href="/upsc/subjects">subject</a> and <a href="/upsc/years">year</a>. The server sleeps when idle, so a first search can take up to a minute — try again shortly.`;
    } finally {
      clearTimeout(slow);
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    run(0);
  });

  form.addEventListener('change', (e) => {
    if (e.target.tagName === 'SELECT') run(0);
  });

  pagerEl.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-page]');
    if (btn) run((Number(btn.dataset.page) - 1) * PAGE_SIZE);
  });

  // Deep links from the landing page and example searches land here.
  const incoming = new URLSearchParams(location.search);
  if (incoming.has('q') || incoming.has('subject')) {
    $('q').value = incoming.get('q') || '';
    ['subject', 'min_year', 'max_year', 'difficulty'].forEach((k) => {
      if (incoming.get(k)) $(k).value = incoming.get(k);
    });
    run(Number(incoming.get('offset') || 0), false);
  }
</script>

<style>
  .searchpage {
    padding-block: clamp(1.5rem, 4vw, 2.75rem);
  }

  .listing-head {
    border-bottom: var(--rule-heavy) solid var(--rule-strong);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  .standfirst {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
  }

  .sform {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .sform-input {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.3rem;
  }

  .sform-input input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-read);
    font-size: 1.05rem;
    padding: 0.8rem 0.9rem;
    color: var(--ink);
    background: var(--paper);
    border: var(--rule-heavy) solid var(--rule-strong);
    border-radius: 0;
  }

  .sform-input input::placeholder {
    color: var(--ink-faint);
  }

  .sform-input button {
    font-family: var(--font-structure);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.8rem 1.5rem;
    color: var(--field-ink);
    background: var(--field);
    border: var(--rule-heavy) solid var(--rule-strong);
    border-radius: 0;
    cursor: pointer;
  }

  .sform-input button:hover {
    background: var(--field-deep);
  }

  .sform-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.25rem;
  }

  .sform-filters label {
    display: grid;
    gap: 0.25rem;
  }

  .sform-filters select {
    font-family: var(--font-structure);
    font-size: 0.9rem;
    padding: 0.45rem 0.5rem;
    color: var(--ink);
    background: var(--paper);
    border: var(--rule-hair) solid var(--rule-strong);
    border-radius: 0;
  }

  .status {
    min-height: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .qlist {
    display: grid;
    gap: 0.75rem;
  }

  @media (max-width: 40rem) {
    .sform-input {
      flex-direction: column;
    }
  }
</style>
