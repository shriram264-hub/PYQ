---
import Listing from '../../../../../layouts/Listing.astro';
import QuestionBlock from '../../../../../components/QuestionBlock.astro';
import Pager from '../../../../../components/Pager.astro';
import { SUBTOPICS, questionsForSubtopic } from '../../../../../lib/corpus.js';

// Every subtopic gets a page, including the thin ones: each question links to
// its own subtopic, so generating only the substantial ones left 82 dead links.
// Thin pages are kept out of the index instead (see `noindex` below) and out of
// the sitemap.
export async function getStaticPaths({ paginate }) {
  return SUBTOPICS.flatMap((topic) => {
    const questions = questionsForSubtopic(topic.subjectSlug, topic.slug).sort(
      (a, b) => b.year - a.year || a.q_no - b.q_no
    );
    return paginate(questions, {
      params: { subject: topic.subjectSlug, topic: topic.slug },
      props: { topic },
      pageSize: 25,
    });
  });
}

const { page, topic } = Astro.props;
const basePath = `/upsc/topic/${topic.subjectSlug}/${topic.slug}`;

const years = [...new Set(page.data.map((q) => q.year))].sort((a, b) => b - a);

const pageSuffix = page.currentPage > 1 ? ` — page ${page.currentPage}` : '';
const title = `${topic.subtopic} — UPSC Prelims Questions${pageSuffix}`;
const description = `${topic.count} UPSC Prelims questions on ${topic.subtopic} (${topic.subject}), with official answers.`;
---

<Listing
  title={title}
  description={description}
  heading={topic.subtopic}
  standfirst={`${topic.count} question${topic.count === 1 ? '' : 's'} in ${topic.subject}.`}
  noindex={topic.count < 5}
  crumbs={[
    { name: 'Subjects', href: '/upsc/subjects' },
    { name: topic.subject, href: `/upsc/subject/${topic.subjectSlug}` },
    { name: topic.subtopic, href: basePath },
  ]}
>
  <p slot="meta" class="years-line serial">
    Asked in {years.join(', ')}
  </p>

  <div class="qlist">
    {page.data.map((q) => <QuestionBlock q={q} />)}
  </div>

  <Pager page={page} basePath={basePath} />
</Listing>

<style>
  .years-line {
    margin: 0.7rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .qlist {
    display: grid;
    gap: 0.75rem;
  }
</style>
