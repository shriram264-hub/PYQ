---
import Document from '../layouts/Document.astro';
import Colophon from '../components/Colophon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import AccountControl from '../components/AccountControl.astro';
import QuestionBlock from '../components/QuestionBlock.astro';
import { EXAMS } from '../lib/exams.js';
import { ALL_QUESTIONS } from '../lib/corpus.js';

const upsc = EXAMS.find((e) => e.slug === 'upsc');
const c = upsc.corpus;

// A real question whose own wording never names the civilisation it belongs
// to: a text search of the paper for these words would not find it. Verified
// against the corpus when this page was written; see the homepage surface brief.
const SPECIMEN_QUERY = 'Indus Valley civilisation';
const specimen = ALL_QUESTIONS.find((q) => q.year === 2021 && q.q_no === 32);

const LIVE = [
  {
    title: 'Search by what a question is about',
    body: "Inside each exam's booklet, describe a topic in your own words and get the questions that asked about it, ranked by how closely they match.",
  },
  {
    title: 'Browse by subject, year and topic',
    body: "Each exam's papers are filed by subject, year and topic, and every question has its own page.",
  },
  {
    title: 'Official answers, flagged honestly',
    body: 'Every recorded answer, with questions later cancelled or disputed marked as such.',
  },
  // Both work without an account, in this browser; signing in is what carries
  // them to other devices, so the copy keeps the two apart.
  {
    title: 'Mark done, or needs review',
    body: 'Mark each question as you work through it. Your marks are kept on this device.',
  },
  {
    title: 'Revision lists',
    body: 'Save questions into named lists to revise from, kept on this device.',
  },
  {
    title: 'Sign in with Google',
    body: 'Optional and free: your marks and revision lists follow you from phone to laptop.',
  },
  { title: 'Free, with no sign-up', body: 'Reading, searching, marking and lists all work without an account or a payment.' },
];

const COMING = [
  { title: "Sit a full year's paper", body: 'Timed, scored with the exam’s real negative marking.' },
  { title: 'See where you are weak', body: 'Accuracy by subject and topic, from your own attempts.' },
];

// The page belongs to every exam, so it speaks for none. The first exam is
// named once here, as a fact, because it is the only one a visitor can open.
const description = `Past exam questions with official answers, searchable by what they're about. First exam open: UPSC Prelims, ${c.total.toLocaleString('en-IN')} questions from ${c.minYear}–${c.maxYear}. Free, no sign-up.`;

// Tells search engines the site's name. There is no site-wide SearchAction:
// search lives inside each exam, and this page speaks for none of them.
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SawaalBox',
  alternateName: 'सवाल बॉक्स',
  url: new URL('/', Astro.site).href,
  description,
};
const specimenSearch = `${upsc.path}/search?q=${encodeURIComponent(SPECIMEN_QUERY)}`;
---

<Document title="Past Exam Questions, Searchable by Topic" description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(website)} />
  <header class="mast">
    <div class="sheet mast-inner">
      <a class="wordmark" href="/">
        <span class="wordmark-latin">SawaalBox</span>
        <span class="wordmark-deva" lang="hi">सवाल बॉक्स</span>
      </a>
      <nav class="mast-nav" aria-label="Sections">
        <a href="#exams">Exams</a>
        <a href="#contents">What's inside</a>
        <AccountControl />
        <ThemeToggle />
      </nav>
      <h1 class="mast-line">Past exam questions, searchable by what they're about.</h1>
    </div>
  </header>

  <main>
    <section id="exams" class="sheet rack" aria-labelledby="rack-heading">
      <h2 id="rack-heading" class="visually-hidden">Exams</h2>
      <div class="rack-shelf">
        <div class="slot">
          <article class="cover cover-open">
            <div class="cover-band">
              <span class="field-label band-label">Series</span>
              <span class="serial band-code">{upsc.series}</span>
            </div>
            <div class="cover-body">
              <h3 class="cover-title">{upsc.name}</h3>
              <dl class="cover-fields">
                <div>
                  <dt class="field-label">Questions</dt>
                  <dd class="serial">{c.total.toLocaleString('en-IN')}</dd>
                </div>
                <div>
                  <dt class="field-label">Years</dt>
                  <dd class="serial">{c.minYear}–{c.maxYear}</dd>
                </div>
                <div>
                  <dt class="field-label">Subjects</dt>
                  <dd class="serial">{c.subjectCount}</dd>
                </div>
              </dl>
              <p class="cover-links">
                {upsc.topSubjects.map((s, i) => (
                  <>
                    {i > 0 && <span aria-hidden="true"> · </span>}
                    <a href={`${upsc.path}/subject/${s.slug}`}>{s.name}</a>
                  </>
                ))}
              </p>
              <a class="cover-open-cta" href={upsc.path}>
                Open the booklet<span class="visually-hidden">: {upsc.name}</span>
              </a>
            </div>
          </article>
        </div>

        <div class="slot">
          <div class="cover cover-sealed" role="note" aria-label="More exams, in preparation">
            <div class="cover-band cover-band-blank">
              <span class="field-label band-label">Series</span>
              <span class="serial band-code">—</span>
            </div>
            <div class="cover-body">
              <p class="cover-title">More exams</p>
              <p class="sealed-line">In preparation. This one opens when its questions are ready.</p>
            </div>
            <span class="seal" aria-hidden="true">Sealed</span>
          </div>
        </div>
      </div>
    </section>

    <section class="sheet specimen" aria-labelledby="specimen-heading">
      <h2 id="specimen-heading">A search that reads past the wording</h2>
      <p class="reading specimen-lede">
        Search <a class="query" href={specimenSearch}>{SPECIMEN_QUERY}</a>{' '}and
        among the results is this {specimen.year} {upsc.short} Prelims question. Its wording never names the
        civilisation, so searching the paper for those words would miss it. Try it before you open
        the answer.
      </p>
      <QuestionBlock q={specimen} />
      <p class="specimen-run">
        <a href={specimenSearch}>Run this search yourself</a>
      </p>
    </section>

    <section id="contents" class="sheet contents" aria-labelledby="contents-heading">
      <h2 id="contents-heading">What's inside</h2>

      <div class="contents-grid">
        <div>
          <h3 class="contents-group">Available now</h3>
          <ol class="entries">
            {
              LIVE.map((item) => (
                <li>
                  <div class="entry-head">
                    {item.href ? (
                      <a class="entry-title" href={item.href}>{item.title}</a>
                    ) : (
                      <span class="entry-title">{item.title}</span>
                    )}
                    <span class="entry-leader" aria-hidden="true" />
                    <span class="entry-state">Open</span>
                  </div>
                  <p class="entry-body">{item.body}</p>
                </li>
              ))
            }
          </ol>
        </div>

        <div>
          <h3 class="contents-group">In preparation</h3>
          <ol class="entries" start={LIVE.length + 1}>
            {
              COMING.map((item) => (
                <li class="entry-coming">
                  <div class="entry-head">
                    <span class="entry-title">{item.title}</span>
                    <span class="entry-leader" aria-hidden="true" />
                    <span class="entry-state entry-state-coming">Coming</span>
                  </div>
                  <p class="entry-body">{item.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>
  </main>

  <Colophon />
</Document>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* --- masthead: the green field, carrying the page's one-line thesis --- */

  .mast {
    background: var(--field);
    color: var(--field-ink);
    border-bottom: var(--rule-heavy) solid var(--rule-strong);
  }

  .mast-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 1.25rem 1.5rem;
    padding-block: clamp(1.25rem, 3vw, 2rem) clamp(1.75rem, 5vw, 3rem);
  }

  .wordmark {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    text-decoration: none;
  }

  .wordmark-latin {
    font-family: var(--font-structure);
    font-weight: 800;
    font-size: clamp(1.45rem, 1rem + 1.6vw, 2rem);
    letter-spacing: -0.035em;
  }

  .wordmark-deva {
    font-size: 1rem;
    color: var(--field-ink-soft);
  }

  .mast-nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    font-family: var(--font-structure);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .mast-nav a {
    text-decoration-color: transparent;
  }

  .mast-nav a:hover {
    text-decoration-color: currentColor;
  }

  .mast-line {
    grid-column: 1 / -1;
    max-width: 22ch;
    font-size: clamp(2rem, 1.1rem + 4.2vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--field-ink);
  }

  /* --- the rack: the page's first act. Search lives inside each booklet,
     so choosing an exam is what this page asks of the visitor. --- */

  .rack {
    padding-block: clamp(1.75rem, 4vw, 2.75rem) 0;
  }

  .rack-shelf {
    --shelf-gap: 1.25rem;
    --plank: 0.6rem;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--shelf-gap);
    align-items: stretch;
  }

  /*
    Each booklet stands on a plank drawn under its own slot. On a wide rack the
    plank also runs across the gap to the next slot, so the covers share one
    shelf; stacked on a phone, each cover gets its own.
  */
  .slot {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-bottom: var(--plank);
    perspective: 1400px;
  }

  .slot::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--plank);
    background: var(--paper-edge);
    border-top: var(--rule-heavy) solid var(--rule-strong);
    border-bottom: var(--rule-hair) solid var(--rule-strong);
  }

  .cover {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: var(--paper);
    border: var(--rule-heavy) solid var(--rule-strong);
    /* the plank's top rule is the cover's bottom edge */
    border-bottom: 0;
  }

  .cover-band {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 1rem;
    background: var(--field);
    color: var(--field-ink);
  }

  .band-label {
    color: var(--field-ink-soft);
  }

  .band-code {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .cover-band-blank {
    background: var(--ground);
    color: var(--ink-faint);
    border-bottom: var(--rule-hair) solid var(--rule);
  }

  .cover-band-blank .band-label {
    color: var(--ink-faint);
  }

  .cover-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.15rem 1.1rem 1.25rem;
    flex: 1;
  }

  .cover-title {
    margin: 0;
    font-family: var(--font-structure);
    font-size: clamp(1.3rem, 0.95rem + 1.3vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    max-width: 18ch;
  }

  .cover-fields {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    margin: 0;
    border: var(--rule-hair) solid var(--rule-strong);
  }

  .cover-fields div {
    padding: 0.45rem 0.8rem;
  }

  .cover-fields div + div {
    border-left: var(--rule-hair) solid var(--rule-strong);
  }

  .cover-fields dt {
    margin: 0;
  }

  .cover-fields dd {
    margin: 0.1rem 0 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .cover-links {
    margin: 0;
    max-width: none;
    font-family: var(--font-structure);
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  /* Raised above the stretched cover link so each subject stays its own target. */
  .cover-links a {
    position: relative;
    z-index: 1;
  }

  /* Filled: opening a booklet is this page's primary action (search lives
     inside the booklet), so it takes the page's one filled-green control. */
  .cover-open-cta {
    margin-top: auto;
    align-self: flex-start;
    padding: 0.7rem 1.25rem;
    font-family: var(--font-structure);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--field-ink);
    background: var(--field);
    border: var(--rule-heavy) solid var(--rule-strong);
  }

  /* The whole cover opens the booklet. The call to action's hit area is
     stretched over it, so the lift below never promises a click that does
     nothing. */
  .cover-open-cta::before {
    content: '';
    position: absolute;
    inset: 0;
  }

  .cover-open:hover .cover-open-cta,
  .cover-open-cta:focus-visible {
    background: var(--field-deep);
  }

  /*
    The signature moment: the open booklet lifts at its spine and the pages
    behind it fan out. At rest a few page edges already show past the cover,
    so it reads as a booklet with pages, not a card. Pointer hover and keyboard
    focus both trigger the lift. The sealed cover has no counterpart: it cannot
    be opened.
  */
  .cover-open {
    transform-origin: left center;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* The fanned-out pages are always drawn at full width; at rest a clip hides
     the outer ones. Revealing them with clip-path keeps layout still while the
     cover moves, where animating width would reflow on every frame. */
  .cover-open::after {
    content: '';
    position: absolute;
    top: 0.3rem;
    bottom: 0;
    left: calc(100% + var(--rule-heavy));
    width: 0.75rem;
    /* hairline page edges: paper, rule, paper, rule... */
    background: repeating-linear-gradient(
      to right,
      var(--paper-edge) 0 2px,
      var(--rule-strong) 2px 3px
    );
    border-top: var(--rule-hair) solid var(--rule-strong);
    clip-path: inset(0 40% 0 0);
    transition: clip-path 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cover-open:hover,
  .cover-open:focus-within {
    transform: rotateY(-5deg);
    box-shadow: 10px 12px 24px -14px rgb(0 0 0 / 0.45);
  }

  .cover-open:hover::after,
  .cover-open:focus-within::after {
    clip-path: inset(0);
  }

  .cover-sealed {
    color: var(--ink-soft);
    overflow: hidden;
  }

  .cover-sealed .cover-body {
    padding-bottom: 5rem;
  }

  .cover-sealed .cover-title {
    color: var(--ink);
  }

  .sealed-line {
    margin: 0;
    max-width: 30ch;
    font-size: 0.95rem;
  }

  /* A paper seal pasted across the cover, in the red real papers reserve for seals. */
  .seal {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: 1.6rem;
    transform: rotate(-7deg);
    padding: 0.35rem 0;
    text-align: center;
    font-family: var(--font-structure);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--seal-ink);
    background: var(--seal);
    pointer-events: none;
  }

  /* --- the specimen: proof, not a claim --- */

  .specimen {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .specimen h2 {
    margin-bottom: 0.8rem;
  }

  .specimen-lede {
    color: var(--ink-soft);
    margin-bottom: 1.25rem;
  }

  .query {
    font-family: var(--font-structure);
    font-weight: 600;
    color: var(--ink);
    padding: 0.05rem 0.4rem;
    background: var(--paper);
    border: var(--rule-hair) solid var(--rule-strong);
    text-decoration: none;
  }

  .specimen-run {
    margin: 0.9rem 0 0;
    font-family: var(--font-structure);
    font-size: 0.92rem;
    font-weight: 600;
  }

  /* --- contents page --- */

  .contents {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .contents h2 {
    margin-bottom: 1.25rem;
    padding-bottom: 0.7rem;
    border-bottom: var(--rule-heavy) solid var(--rule-strong);
  }

  .contents-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 2.5rem;
  }

  .contents-group {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    color: var(--ink-soft);
  }

  .entries {
    margin: 0;
    padding: 0 0 0 1.75rem;
    display: grid;
    gap: 1rem;
  }

  .entries li::marker {
    font-family: var(--font-serial);
    color: var(--ink-faint);
  }

  .entry-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 0.6rem;
  }

  .entry-title {
    font-family: var(--font-structure);
    font-weight: 700;
    font-size: 1.02rem;
  }

  .entry-leader {
    border-bottom: var(--rule-hair) dotted var(--rule);
    transform: translateY(-0.28em);
  }

  .entry-state {
    font-family: var(--font-structure);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--field-text);
  }

  .entry-state-coming {
    color: var(--ink-faint);
  }

  .entry-body {
    margin: 0.2rem 0 0;
    font-size: 0.93rem;
    color: var(--ink-soft);
  }

  .entry-coming .entry-title {
    color: var(--ink-soft);
  }

  @media (min-width: 52.01rem) {
    .slot:not(:last-child)::after {
      right: calc(-1 * var(--shelf-gap));
    }
  }

  @media (max-width: 52rem) {
    .rack-shelf,
    .contents-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .mast-inner {
      grid-template-columns: 1fr;
    }

    .mast-nav {
      flex-wrap: wrap;
    }

    .cover-fields {
      grid-template-columns: 1fr;
    }

    .cover-fields div + div {
      border-left: 0;
      border-top: var(--rule-hair) solid var(--rule-strong);
    }
  }
</style>
