---
// The plan card, and where a student buys the pass. Upgrade prompts link here
// (/plans?return=<path>). The pass facts come from lib/passes.js.
//
// With payments off (lib/payments/switch.js) the card is exactly as it was
// before payments: an inert Coming soon and the beta line. Otherwise the action
// area serves every state's markup at once and scripts/plans-page.js picks one:
// pending (nothing yet), signed out, buy, active, or sales closed. The states
// share one grid cell, so the cell is as tall as the tallest of them from the
// first paint and choosing one moves nothing below it.
import Listing from '../layouts/Listing.astro';
import { longDate } from '../lib/legal.js';
import { passFor } from '../lib/passes.js';
import { DROPPED, RELOAD } from '../lib/payments/plans-copy.js';
import { currentPayments, paymentsCopy } from '../lib/payments/switch.js';

const pass = passFor('upsc');
const until = longDate(pass.validUntil);
// Stored as a heading-style line; mid-sentence it starts lower case.
const taster = pass.taster.charAt(0).toLowerCase() + pass.taster.slice(1);

const payments = currentPayments();
const selling = payments.state !== 'off';
const copy = paymentsCopy(payments);
const needsFrom = selling ? `Tests and analytics need the pass from ${longDate(payments.from)}.` : '';
const description = selling
  ? `The SawaalBox ${pass.name}: ${pass.priceLabel} once, valid until ${until}. ${needsFrom}`
  : `The SawaalBox ${pass.name}: ${pass.priceLabel} once, valid until ${until}. Payments are not open yet; tests and analytics are free during the beta.`;
// The longest thing the status line can say (the dropped confirmation, then
// the reload line under it). It sits, invisible, in the status line's cell so
// that line holds its room before any message arrives.
---

<Listing
  title="Plans"
  description={description}
  heading="Plans"
  standfirst="One pass for the UPSC Prelims. Pay once, no subscription."
>
  <section class="ruled plan" aria-labelledby="plan-h">
    <div class="plan-head">
      <h2 id="plan-h">{pass.name}</h2>
      <p class="plan-price"><span class="price serial">{pass.priceLabel}</span></p>
      <p class="plan-until">One payment, valid until {until}.</p>
    </div>

    <div class="plan-body">
      <h3 class="field-label">It unlocks</h3>
      <ul class="plan-list">
        {pass.unlocks.map((item) => <li>{item}</li>)}
      </ul>

      <h3 class="field-label">Free taster</h3>
      {
        copy.phase === 'scheduled' ? (
          <p class="plan-taster">
            From {copy.fromLabel}, anyone can try this before buying, with or without an account: {taster}.
          </p>
        ) : (
          <p class="plan-taster">Once payments start, a free account can try {taster}, before you buy.</p>
        )
      }
    </div>

    {
      selling ? (
        <div class="plan-action plan-selling" data-plan data-pass={pass.exam}>
          <div class="plan-states" data-plan-states data-state="pending">
            <div class="plan-state" data-state-panel="pending"></div>
            <div class="plan-state" data-state-panel="signed-out">
              <button type="button" class="plan-btn" data-plan-signin>
                Sign in with Google to buy
              </button>
            </div>
            <div class="plan-state plan-row" data-state-panel="buy">
              {/* The page's one filled-green action (DESIGN.md Primary). */}
              <button type="button" class="plan-btn plan-primary" data-plan-buy>
                Buy for {pass.priceLabel}
              </button>
              <p class="plan-note">One payment, valid until {until}. Paid through Razorpay.</p>
            </div>
            <div class="plan-state" data-state-panel="active">
              <p class="plan-active">
                Your {pass.name} is active until {until}
              </p>
              <p class="plan-links" data-plan-links>
                <a href={`/${pass.exam}/test`}>Practice tests</a>
                <a href={`/${pass.exam}/analytics`}>Your analytics</a>
              </p>
              <p class="plan-links" data-plan-back hidden>
                <a href="/" data-plan-back-link>
                  Go back to where you were
                </a>
              </p>
            </div>
            <div class="plan-state" data-state-panel="closed">
              <p class="plan-closed">Sales of this pass have closed. Next year's pass is coming.</p>
            </div>
          </div>
          <p class="plan-beta">{needsFrom}</p>
          <div class="plan-status-cell">
            <p class="plan-status plan-sizer" aria-hidden="true">
              {DROPPED}<br />{RELOAD}
            </p>
            <p class="plan-status" role="status" data-plan-status></p>
          </div>
        </div>
      ) : (
        <div class="plan-action">
          <button type="button" class="plan-buy" data-pass={pass.exam} disabled>Coming soon</button>
          <p class="plan-beta">Tests and analytics are free during the beta.</p>
        </div>
      )
    }
  </section>

  <section class="free" aria-labelledby="free-h">
    <h2 id="free-h">Always free</h2>
    <ul class="plan-list">
      {pass.free.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <nav class="policies" aria-label="Pass policies">
    <a href="/pricing">Pricing</a>
    <a href="/refunds">Refunds</a>
    <a href="/delivery">Delivery</a>
  </nav>
</Listing>

{
  selling && (
    <script>
      import '../scripts/plans-page.js';
    </script>
  )
}

<style>
  .plan {
    max-width: 38rem;
  }

  .plan-head {
    padding: 1rem 1.1rem 1.1rem;
    border-bottom: var(--rule-heavy) solid var(--rule-strong);
  }

  .plan-head h2 {
    margin: 0;
  }

  .plan-price {
    margin: 0.5rem 0 0.2rem;
  }

  .price {
    font-size: clamp(1.9rem, 1.2rem + 3vw, 3.4rem);
    font-weight: 700;
    line-height: 1.12;
  }

  .plan-until {
    margin: 0;
    color: var(--ink-soft);
  }

  .plan-body {
    padding: 1rem 1.1rem 0.4rem;
  }

  .plan-body .field-label {
    margin: 0 0 0.5rem;
  }

  .plan-list {
    margin: 0 0 1.2rem;
    padding-left: 1.25rem;
  }

  .plan-list li {
    margin-bottom: 0.45rem;
  }

  .plan-list li::marker {
    color: var(--ink-faint);
  }

  .plan-taster {
    margin: 0 0 1rem;
  }

  .plan-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
    padding: 1rem 1.1rem 1.1rem;
    border-top: var(--rule-hair) solid var(--rule-strong);
  }

  /* DESIGN.md's Secondary: paper, a heavy frame, Archivo 700. It is inert
     because there is nothing to buy yet, so the frame turns dashed (the
     system's mark for something provisional) and the label stays in Soft Ink,
     which reads at 7:1 on paper by day and by night. */
  .plan-buy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.25rem;
    font: 700 0.95rem/1.2 var(--font-structure);
    color: var(--ink-soft);
    background: var(--paper);
    border: var(--rule-heavy) dashed var(--rule-strong);
    border-radius: 0;
    cursor: not-allowed;
  }

  .plan-beta {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  /* Selling: the states, the beta line and the status line, one under another. */
  .plan-selling {
    display: block;
  }

  /* Every state in one cell: the cell takes the tallest one's height from the
     first paint, and only the chosen one is seen (visibility, not display, so
     the others keep holding the room and are out of the tab order and the
     accessibility tree). Pending shows nothing: an empty row of that height. */
  .plan-states {
    display: grid;
  }
  .plan-state {
    grid-area: 1 / 1;
    visibility: hidden;
    align-self: center;
  }
  .plan-states[data-state='signed-out'] > [data-state-panel='signed-out'],
  .plan-states[data-state='buy'] > [data-state-panel='buy'],
  .plan-states[data-state='active'] > [data-state-panel='active'],
  .plan-states[data-state='closed'] > [data-state-panel='closed'] {
    visibility: visible;
  }

  .plan-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
  }

  /* DESIGN.md Secondary (Sign in), and Primary (Buy) on top of it. */
  .plan-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.25rem;
    font: 700 0.95rem/1.2 var(--font-structure);
    color: var(--field-text);
    background: var(--paper);
    border: var(--rule-heavy) solid var(--rule-strong);
    border-radius: 0;
    cursor: pointer;
  }
  .plan-btn:hover {
    background: var(--ground);
  }
  .plan-primary {
    padding: 0.85rem 1.6rem;
    color: var(--field-ink);
    background: var(--field);
    border-color: var(--field);
  }
  .plan-primary:hover {
    background: var(--field-deep);
    border-color: var(--field-deep);
  }
  /* Busy while an order is made or Checkout is open: still focusable (so focus
     is not dropped to the page), pressing it does nothing. */
  .plan-btn[aria-disabled='true'] {
    cursor: progress;
  }

  .plan-note,
  .plan-closed {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .plan-active {
    margin: 0;
    font-weight: 600;
  }

  .plan-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0.45rem 0 0;
    font-family: var(--font-structure);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .plan-links[hidden] {
    display: none;
  }

  .plan-selling .plan-beta {
    margin-top: 0.8rem;
  }

  /* The status line holds the room of its longest message (the sizer, unseen),
     so a message arriving moves nothing below the card. */
  .plan-status-cell {
    display: grid;
    margin-top: 0.5rem;
  }
  .plan-status {
    grid-area: 1 / 1;
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink);
  }
  .plan-sizer {
    visibility: hidden;
  }

  .free {
    max-width: 38rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .free h2 {
    margin-bottom: 0.7rem;
  }

  .free .plan-list {
    margin-bottom: 0;
  }

  .policies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    padding-top: 1rem;
    border-top: var(--rule-hair) solid var(--rule);
    font-family: var(--font-structure);
    font-size: 0.92rem;
    font-weight: 600;
  }

  @media (pointer: coarse) {
    .policies a,
    .plan-links a {
      display: inline-block;
      padding-block: 0.45rem;
    }
    .plan-btn {
      min-height: 2.75rem;
    }
  }
</style>
