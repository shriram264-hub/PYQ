---
import Listing from '../layouts/Listing.astro';
import { authEnabled } from '../lib/accounts/config.js';
import { LEGAL } from '../lib/legal.js';
---

<Listing
  title="Your Progress"
  description="Questions you have marked and your revision lists."
  heading="Your progress"
  noindex={true}
>
  <div slot="meta" class="acct-where">
    {/* Until sign-in is switched on (see lib/accounts/config.js) this page says
        nothing about accounts: no wording, no button. progress-page.js changes
        the line only when it is on. */}
    <p class="acct-where-text" data-where>Kept on this device.</p>
    {
      authEnabled && (
        <button type="button" class="acct-btn" data-signin hidden>
          Sign in
        </button>
      )
    }
    {/* The beta terms, said before anyone signs in and kept in view after.
        Shown with the line above once the session check has settled. */}
    {
      authEnabled && (
        <p class="acct-terms" data-terms hidden>
          {LEGAL.betaTerms} See the <a href="/terms">terms of use</a> and the <a href="/privacy">privacy policy</a>.
        </p>
      )
    }
    <p class="acct-note" role="status" data-where-note></p>
  </div>

  <noscript><p class="acct-empty">This page needs JavaScript to show what is kept on this device.</p></noscript>

  {/* data-sync-full: this page shows everything the account holds, so a sync
      started here reads all of it (see startSync in scripts/sync.js). */}
  <div class="acct" data-sync-full={authEnabled ? '' : undefined}>
    <section class="acct-section" aria-labelledby="acct-sum-h">
      <h2 id="acct-sum-h">By subject</h2>
      <div data-summary></div>
    </section>

    <section class="acct-section" aria-labelledby="acct-rev-h">
      <h2 id="acct-rev-h" tabindex="-1">Needs review</h2>
      <div data-review></div>
    </section>

    <section class="acct-section" aria-labelledby="acct-lists-h">
      <h2 id="acct-lists-h" tabindex="-1">Revision lists</h2>
      <p class="acct-note" role="status" data-lists-note></p>
      <div data-lists></div>
    </section>
  </div>
</Listing>

<script>
  import '../scripts/progress-page.js';
</script>

<style is:global>
  /* Global, not scoped: most of this page is drawn by progress-page.js, and
     Astro's scoped styles never reach markup a script creates. Every class is
     prefixed acct- so nothing here can leak. */
  .acct {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
  }

  .acct h2,
  .acct h3 {
    outline-offset: 4px;
  }

  /* Without scripting every section would be an empty heading. The noscript
     line says why, and the headings go. */
  @media (scripting: none) {
    .acct {
      display: none;
    }
  }

  .acct-section h2 {
    margin-bottom: 0.8rem;
  }

  .acct-where {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.1rem;
    margin-top: 0.8rem;
  }

  .acct-where-text {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.02rem;
  }

  .acct-empty {
    margin: 0;
    color: var(--ink-soft);
  }

  /* Its own row under the status line and the button. */
  .acct-terms {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  /* One live region per place something can happen. It is always in the page
     (a region that is created together with its text may not be announced).
     While it holds nothing, or a success only a screen reader needs, it takes
     no room; a failure is shown. */
  .acct-note {
    margin: 0;
    max-width: var(--measure);
    font-size: 0.9rem;
    color: var(--ink);
  }
  .acct-note:not([data-error]) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .acct-note[data-error] {
    flex-basis: 100%;
    margin-bottom: 0.8rem;
    padding: 0.5rem 0.75rem;
    background: var(--paper);
    border: var(--rule-heavy) solid var(--rule-strong);
  }

  /* Sign in is a secondary action, drawn as "Open the booklet" is: outlined on
     paper with a green label. This page's job is to show the student their own
     work, so nothing on it is the filled-green primary. */
  .acct-btn {
    padding: 0.7rem 1.25rem;
    font: 700 0.95rem var(--font-structure);
    color: var(--field-text);
    background: var(--paper);
    border: var(--rule-heavy) solid var(--rule-strong);
    border-radius: 0;
    cursor: pointer;
  }
  .acct-btn:hover {
    background: var(--ground);
  }
  .acct-btn[hidden] {
    display: none;
  }

  /* --- by subject --- */

  .acct-table {
    width: 100%;
    max-width: 38rem;
    border-collapse: collapse;
    background: var(--paper);
    border: var(--rule-hair) solid var(--rule-strong);
  }
  .acct-table th,
  .acct-table td {
    padding: 0.5rem 0.9rem;
    text-align: left;
    border-bottom: var(--rule-hair) solid var(--rule);
  }
  .acct-table th[scope='row'] {
    font: 600 0.95rem var(--font-structure);
    overflow-wrap: anywhere;
  }
  .acct-table thead th {
    font: 600 0.68rem var(--font-structure);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: var(--rule-heavy) solid var(--rule-strong);
  }
  .acct-table .acct-num {
    text-align: right;
  }
  .acct-table td.acct-num {
    font-family: var(--font-serial);
    font-weight: 700;
  }
  .acct-table tfoot th,
  .acct-table tfoot td {
    border-top: var(--rule-heavy) solid var(--rule-strong);
    border-bottom: 0;
  }
  .acct-after {
    margin: 0.7rem 0 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  /* --- question rows: needs review, and inside each list --- */

  .acct-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    max-width: 52rem;
  }
  .acct-item {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    padding: 0.6rem 0;
    border-bottom: var(--rule-hair) solid var(--rule);
  }
  .acct-item:last-child {
    border-bottom: 0;
  }
  .acct-ref {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  /* A row with no title (its year file still loading, or a key the index
     does not know) gives the serial the title's column too, so Remove stays
     a small button at the right instead of stretching across the gap. */
  .acct-ref[data-waiting],
  .acct-ref[data-unplaced] {
    grid-column: 1 / 3;
  }
  /* A key the index does not know is shown as the key, quietly. */
  .acct-ref[data-unplaced] {
    font-weight: 400;
    color: var(--ink-soft);
  }
  .acct-q {
    min-width: 0;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .acct-q a {
    text-decoration-color: var(--rule);
  }
  .acct-q a:hover {
    text-decoration-color: currentColor;
  }

  .acct-remove {
    align-self: center;
    min-height: 2rem;
    padding: 0.25rem 0.75rem;
    font: 600 0.78rem var(--font-structure);
    letter-spacing: 0.04em;
    color: var(--ink);
    background: transparent;
    border: var(--rule-hair) solid var(--rule-strong);
    border-radius: 0;
    cursor: pointer;
  }
  .acct-remove:hover {
    background: var(--ground);
  }

  /* --- lists --- */

  /* The same width as the review list, so a list's count and its Remove
     buttons sit at the box's edge instead of a screen's width away. */
  .acct-lists {
    display: grid;
    gap: 1rem;
    max-width: 52rem;
  }
  .acct-set {
    background: var(--paper);
    border: var(--rule-hair) solid var(--rule);
    padding: 0.9rem 1.1rem 0.4rem;
  }
  .acct-set-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 1rem;
    padding-bottom: 0.4rem;
    border-bottom: var(--rule-heavy) solid var(--rule-strong);
  }
  .acct-set-head h3 {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .acct-count {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .acct-set .acct-empty {
    padding: 0.7rem 0;
  }

  @media (max-width: 36rem) {
    /* The serial moves above the question, so the title keeps the width. */
    .acct-item {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .acct-ref {
      grid-column: 1 / -1;
    }
    /* A row with no title has nothing to put under the serial: the serial
       keeps the first column and Remove the second, on one line. */
    .acct-ref[data-waiting],
    .acct-ref[data-unplaced] {
      grid-column: 1;
    }
  }

  @media (pointer: coarse) {
    .acct-remove {
      min-height: 2.75rem;
      padding-inline: 1rem;
    }
    .acct-btn {
      min-height: 2.75rem;
    }
  }
</style>
