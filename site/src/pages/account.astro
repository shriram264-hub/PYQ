---
import Listing from '../layouts/Listing.astro';
import { authEnabled } from '../lib/accounts/config.js';
import { LEGAL } from '../lib/legal.js';
---

<Listing
  title="Your Progress"
  description="Questions you have marked and your revision lists."
  heading="Your progress"
  noindex={true}
>
  <div slot="meta" class="acct-where">
    {/* Until sign-in is switched on (see lib/accounts/config.js) this page says
        nothing about accounts: no wording, no button. progress-page.js changes
        the line only when it is on. */}
    <p class="acct-where-text" data-where>Kept on this device.</p>
    {
      authEnabled && (
        <button type="button" class="acct-btn" data-signin hidden>
          Sign in
        </button>
      )
    }
    {/* The beta terms, said before anyone signs in and kept in view after.
        Shown with the line above once the session check has settled. */}
    {
      authEnabled && (
        <p class="acct-terms" data-terms hidden>
          {LEGAL.betaTerms} See the <a href="/terms">terms of use</a> and the <a href="/privacy">privacy policy</a>.
        </p>
      )
    }
    <p class="acct-note" role="status" data-where-note></p>
  </div>

  <noscript><p class="acct-empty">This page needs JavaScript to show what is kept on this device.</p></noscript>

  {/* data-sync-full: this page shows everything the account holds, so a sync
      started here reads all of it (see startSync in scripts/sync.js).
      data-pending: nothing in here is on screen until progress-page.js has drawn
      it (see the gate in the styles), so what it draws never pushes anything
      the reader can already see.
      Revision comes first: its cards are the part that can be drawn from this
      device alone. By subject needs the question indexes, so it grows after
      they arrive, and it goes last so that growth moves nothing but the
      colophon, which is held back until then. */}
  <div class="acct" data-pending data-sync-full={authEnabled ? '' : undefined}>
    <section class="acct-section" id="lists" aria-labelledby="acct-lists-h">
      <h2 id="acct-lists-h" tabindex="-1">Revision</h2>
      <p class="acct-note" role="status" data-lists-note></p>
      <div data-lists></div>
    </section>

    <section class="acct-section" aria-labelledby="acct-sum-h">
      <h2 id="acct-sum-h">By subject</h2>
      <div data-summary></div>
    </section>
  </div>
</Listing>

<script>
  import '../scripts/progress-page.js';
</script>

<style is:global>
  /* Global, not scoped: most of this page is drawn by progress-page.js, and
     Astro's scoped styles never reach markup a script creates. Every class is
     prefixed acct- so nothing here can leak. */
  .acct {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
  }

  .acct h2,
  .acct h3 {
    outline-offset: 4px;
  }

  /* Without scripting every section would be an empty heading. The noscript
     line says why, and the headings go. */
  @media (scripting: none) {
    .acct {
      display: none;
    }
  }

  .acct-section h2 {
    margin-bottom: 0.8rem;
  }

  .acct-where {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.1rem;
    margin-top: 0.8rem;
  }

  .acct-where-text {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.02rem;
  }

  .acct-empty {
    margin: 0;
    color: var(--ink-soft);
  }

  /* Its own row under the status line and the button. */
  .acct-terms {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  /* One live region per place something can happen. It is always in the page
     (a region that is created together with its text may not be announced).
     While it holds nothing, or a success only a screen reader needs, it takes
     no room; a failure is shown. */
  .acct-note {
    margin: 0;
    max-width: var(--measure);
    font-size: 0.9rem;
    color: var(--ink);
  }
  .acct-note:not([data-error]) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .acct-note[data-error] {
    flex-basis: 100%;
    margin-bottom: 0.8rem;
    padding: 0.5rem 0.75rem;
    background: var(--paper);
    border: var(--rule-heavy) solid var(--rule-strong);
  }

  /* Sign in is a secondary action, drawn as "Open the booklet" is: outlined on
     paper with a green label. This page's job is to show the student their own
     work, so nothing on it is the filled-green primary. */
  .acct-btn {
    padding: 0.7rem 1.25rem;
    font: 700 0.95rem var(--font-structure);
    color: var(--field-text);
    background: var(--paper);
    border: var(--rule-heavy) solid var(--rule-strong);
    border-radius: 0;
    cursor: pointer;
  }
  .acct-btn:hover {
    background: var(--ground);
  }
  .acct-btn[hidden] {
    display: none;
  }

  /* --- by subject --- */

  .acct-table {
    width: 100%;
    max-width: 38rem;
    border-collapse: collapse;
    background: var(--paper);
    border: var(--rule-hair) solid var(--rule-strong);
  }
  .acct-table th,
  .acct-table td {
    padding: 0.5rem 0.9rem;
    text-align: left;
    border-bottom: var(--rule-hair) solid var(--rule);
  }
  .acct-table th[scope='row'] {
    font: 600 0.95rem var(--font-structure);
    overflow-wrap: anywhere;
  }
  .acct-table thead th {
    font: 600 0.68rem var(--font-structure);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: var(--rule-heavy) solid var(--rule-strong);
  }
  .acct-table .acct-num {
    text-align: right;
  }
  .acct-table td.acct-num {
    font-family: var(--font-serial);
    font-weight: 700;
  }
  .acct-table tfoot th,
  .acct-table tfoot td {
    border-top: var(--rule-heavy) solid var(--rule-strong);
    border-bottom: 0;
  }
  .acct-after {
    margin: 0.7rem 0 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  /* --- revision: a card for Needs review, then one per list --- */

  .acct-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }
  .acct-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.9rem 1.1rem 1rem;
    background: var(--paper);
    border: var(--rule-hair) solid var(--rule);
  }
  .acct-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 1rem;
    padding-bottom: 0.45rem;
    border-bottom: var(--rule-heavy) solid var(--rule-strong);
  }
  .acct-card-head h3 {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .acct-count {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  /* The subjects arrive once the years the card's questions are in have
     loaded, so the line is always one line tall and always there for a card
     that has questions: it fills in without the card growing. It never wraps
     (a second line could not be told of in advance); the first part gives way
     with an ellipsis and the "+k more" stays, since that is the part that
     says there is more. */
  .acct-subjects {
    display: flex;
    margin: 0;
    min-height: 1.45em;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .acct-subjects-top {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .acct-subjects-more {
    flex: none;
    white-space: pre;
  }
  .acct-card .acct-empty {
    font-size: 0.92rem;
  }

  /* Revise, Rename and Delete, at the foot of the card so the cards in a row
     line up whatever their names do. */
  .acct-actions,
  .acct-confirm {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.9rem;
    margin-top: auto;
    padding-top: 0.35rem;
  }
  .acct-card .acct-btn {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    font-size: 0.9rem;
    text-decoration: none;
  }
  /* A text button: quiet, underlined so it still reads as pressable. Delete is
     not drawn in red; red is stamp ink, never an action. */
  .acct-text-btn {
    min-height: 2.25rem;
    padding: 0.3rem 0.15rem;
    font: 600 0.85rem var(--font-structure);
    letter-spacing: 0.02em;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-radius: 0;
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .acct-text-btn:hover {
    text-decoration-thickness: 2px;
  }

  .acct-confirm {
    border-top: var(--rule-hair) dashed var(--rule-strong);
  }
  .acct-confirm-text {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  .acct-edit {
    display: flex;
    flex: 1 1 100%;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .acct-edit input {
    flex: 1 1 11rem;
    min-width: 0;
    padding: 0.5rem 0.7rem;
    font: 1.02rem var(--font-read);
    color: var(--ink);
    background: var(--ground);
    border: var(--rule-heavy) solid var(--rule-strong);
    border-radius: 0;
  }
  .acct .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The full-width line under the cards when there are no lists yet. */
  .acct-cards > .acct-empty {
    grid-column: 1 / -1;
  }

  /* --- nothing moves what the reader can already see --- */

  /* progress-page.js draws everything on this page, and some of it only once the
     question indexes have arrived. Chrome does not paint what is
     visibility: hidden, so none of it is on screen to be pushed. The
     page shows nothing in the area until the first draw, and the colophon (the one
     thing below the By subject table, which grows when the indexes
     land) stays out of sight until then too. The page itself reserves no height:
     what it will hold depends on what is in this browser's storage, which no
     stylesheet can know. The animations are the way out if the script never
     runs: both reveal after a few seconds on their own. */
  @keyframes acct-reveal {
    to {
      visibility: visible;
    }
  }
  @media (scripting: enabled) {
    .acct[data-pending] {
      visibility: hidden;
      animation: acct-reveal 0s 4s forwards;
    }
    body:has(.acct[data-pending], .acct[data-settling]) .colophon {
      visibility: hidden;
      animation: acct-reveal 0s 6s forwards;
    }
  }

  @media (pointer: coarse) {
    .acct-btn,
    .acct-text-btn {
      min-height: 2.75rem;
    }
    .acct-text-btn {
      padding-inline: 0.5rem;
    }
  }
</style>
