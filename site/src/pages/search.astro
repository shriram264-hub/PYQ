---
// Search moved inside the exam it searches (/upsc/search). Links people
// already shared still land on their results: the query string is carried
// across. Every old /search link was a UPSC search, so UPSC is the right home
// even once other exams open. noindex, so search engines drop this address.
import Document from '../layouts/Document.astro';
---

<Document
  title="Search Has Moved"
  description="Search now lives inside each exam's booklet."
  noindex={true}
>
  <script is:inline>
    location.replace('/upsc/search' + location.search + location.hash);
  </script>
  <main class="sheet moved">
    <p>
      Search now lives inside each exam's booklet.
      <a href="/upsc/search">Search UPSC Prelims questions</a>
    </p>
  </main>
</Document>

<style>
  .moved {
    padding-block: 3rem;
    font-family: var(--font-structure);
  }
</style>
