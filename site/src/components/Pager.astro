---
const { page, basePath } = Astro.props;

// Must match what Astro's paginate() actually emits: /base for page 1 and
// /base/<n> after that. Anything else 404s.
const href = (n) => (n === 1 ? basePath : `${basePath}/${n}`);

// A compact window around the current page, always including first and last.
const total = page.lastPage;
const current = page.currentPage;
const window = new Set([1, total, current]);
for (let i = current - 2; i <= current + 2; i += 1) {
  if (i >= 1 && i <= total) window.add(i);
}
const numbers = [...window].sort((a, b) => a - b);

const withGaps = [];
numbers.forEach((n, i) => {
  if (i > 0 && n - numbers[i - 1] > 1) withGaps.push('gap');
  withGaps.push(n);
});

const from = (current - 1) * page.size + 1;
const to = Math.min(current * page.size, page.total);
---

{
  total > 1 && (
    <nav class="pager" aria-label="Pagination">
      <p class="pager-count serial">
        Showing {from.toLocaleString('en-IN')}–{to.toLocaleString('en-IN')} of{' '}
        {page.total.toLocaleString('en-IN')}
      </p>
      <ul class="pager-list">
        <li>
          {page.url.prev ? (
            <a class="pager-step" href={page.url.prev} rel="prev">
              Previous
            </a>
          ) : (
            <span class="pager-step is-off" aria-disabled="true">
              Previous
            </span>
          )}
        </li>
        {withGaps.map((n) =>
          n === 'gap' ? (
            <li class="pager-gap" aria-hidden="true">
              …
            </li>
          ) : (
            <li>
              {n === current ? (
                <span class="pager-n is-current serial" aria-current="page">
                  {n}
                </span>
              ) : (
                <a class="pager-n serial" href={href(n)}>
                  {n}
                </a>
              )}
            </li>
          )
        )}
        <li>
          {page.url.next ? (
            <a class="pager-step" href={page.url.next} rel="next">
              Next
            </a>
          ) : (
            <span class="pager-step is-off" aria-disabled="true">
              Next
            </span>
          )}
        </li>
      </ul>
    </nav>
  )
}
