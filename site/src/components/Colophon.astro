---
import { EXAMS, examForPath } from '../lib/exams.js';

// Inside an exam, the footer offers that exam's own indexes and search.
// Everywhere else (the homepage) it offers one entry per exam, so it never
// speaks for a single exam on a page that belongs to all of them.
const exam = examForPath(Astro.url.pathname);
const links = exam
  ? [
      { name: 'All subjects', href: `${exam.path}/subjects` },
      { name: 'All years', href: `${exam.path}/years` },
      { name: 'Search', href: `${exam.path}/search` },
    ]
  : EXAMS.map((e) => ({ name: e.name, href: e.path }));

// On every page, from the homepage to a single question: Google's consent
// screen and anyone with a data question must be able to find them.
const LEGAL_LINKS = [
  { name: 'Privacy', href: '/privacy' },
  { name: 'Terms', href: '/terms' },
  { name: 'Contact', href: '/contact' },
];

const sources = EXAMS.map((e) => `${e.source}, ${e.corpus.minYear}–${e.corpus.maxYear}`).join('; ');
---

<footer class="colophon">
  <div class="sheet colophon-inner">
    <p>
      SawaalBox is free and needs no account. Questions are reproduced from past papers: {sources}.
    </p>
    <nav aria-label="Footer">
      {links.map((link) => <a href={link.href}>{link.name}</a>)}
    </nav>
    {/* Its own row under a hairline: the line above is where to go in the
        question bank, this one is about the site itself. */}
    <nav class="colophon-legal" aria-label="Site policies">
      {LEGAL_LINKS.map((link) => <a href={link.href}>{link.name}</a>)}
    </nav>
  </div>
</footer>

<style>
  .colophon {
    background: var(--field);
    color: var(--field-ink);
    border-top: var(--rule-heavy) solid var(--rule-strong);
    margin-top: 2.5rem;
  }

  .colophon-inner {
    padding-block: 1.5rem;
    display: grid;
    gap: 0.8rem;
  }

  .colophon p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--field-ink-soft);
    max-width: var(--measure);
  }

  .colophon nav {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    font-family: var(--font-structure);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .colophon .colophon-legal {
    padding-top: 0.8rem;
    border-top: var(--rule-hair) solid var(--field-rule);
    font-size: 0.8rem;
    color: var(--field-ink-soft);
  }

  .colophon-legal a:hover {
    color: var(--field-ink);
  }
</style>
