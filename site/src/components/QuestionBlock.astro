---
import { CORPUS } from '../lib/corpus.js';

const { q, headingLevel = 'h3', linked = true, open = false } = Astro.props;

const Heading = headingLevel;
const OPTIONS = ['a', 'b', 'c', 'd'];
const href = `/upsc/question/${q.slug}`;
---

<article class="qblock">
  <div class="qhead">
    <span class="serial qref">
      {q.year} · Q{q.q_no}
    </span>
    <a class="qsubject" href={`/upsc/subject/${q.subjectSlug}`}>{q.subject}</a>
    <span class="qsep" aria-hidden="true">›</span>
    <a class="qsubtopic" href={`/upsc/topic/${q.subjectSlug}/${q.subtopicSlug}`}>{q.subtopic}</a>
    <span class={`qdiff qdiff-${q.difficulty}`}>{q.difficulty}</span>
    {q.status === 'cancelled' && <span class="qflag">Cancelled by UPSC</span>}
    {q.status === 'disputed' && <span class="qflag qflag-warn">Answer disputed</span>}
  </div>

  <Heading class="qtext">
    {linked ? <a href={href}>{q.question}</a> : q.question}
  </Heading>

  <ol class="qopts">
    {
      OPTIONS.map((key) => (
        <li class={q.answer === key ? 'is-answer' : ''}>
          <span class="serial qopt-key">({key})</span>
          <span class="qopt-text">{q[key]}</span>
        </li>
      ))
    }
  </ol>

  {
    q.answer ? (
      <details class="qanswer" open={open}>
        <summary>
          <span class="lbl-show">Show answer</span>
          <span class="lbl-hide">Hide answer</span>
        </summary>
        <div class="qanswer-body">
          <p>
            <span class="field-label">Official answer</span>
            <strong class="serial">({q.answer})</strong> {q[q.answer]}
          </p>
          {q.answer_note && <p class="qnote">{q.answer_note}</p>}
        </div>
      </details>
    ) : (
      <p class="qanswer-none">
        No answer is recorded for this question{q.answer_note ? `: ${q.answer_note}` : '.'}
      </p>
    )
  }
</article>

<style>
  .qblock {
    background: var(--paper);
    border: var(--rule-hair) solid var(--rule);
    padding: 1rem 1.1rem;
  }

  .qhead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    font-family: var(--font-structure);
    font-size: 0.78rem;
    color: var(--ink-soft);
    margin-bottom: 0.65rem;
  }

  .qref {
    font-weight: 700;
    color: var(--ink);
  }

  .qsep {
    opacity: 0.5;
  }

  .qdiff {
    margin-left: auto;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.68rem;
    font-weight: 600;
  }

  .qdiff-difficult {
    color: var(--stamp);
  }

  .qflag {
    border: var(--rule-hair) solid var(--stamp);
    color: var(--stamp);
    padding: 0.05rem 0.4rem;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .qtext {
    font-family: var(--font-read);
    font-size: 1.02rem;
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0;
    white-space: pre-wrap;
    margin: 0 0 0.8rem;
    max-width: var(--measure);
  }

  .qtext a {
    text-decoration-color: var(--rule);
  }

  .qopts {
    list-style: none;
    margin: 0 0 0.9rem;
    padding: 0;
    display: grid;
    gap: 0.28rem;
    max-width: var(--measure);
  }

  .qopts li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.35rem;
    align-items: baseline;
    padding: 0.18rem 0.35rem;
  }

  .qopt-key {
    color: var(--ink-faint);
    font-size: 0.9rem;
  }

  /* The correct option is only marked once the seal is broken. The options
     precede the answer in the DOM, so this has to reach up to the block. */
  .qblock:has(.qanswer[open]) .qopts .is-answer {
    background: var(--ground);
    outline: var(--rule-hair) solid var(--rule-strong);
  }

  .qanswer {
    border-top: var(--rule-hair) dashed var(--rule);
    padding-top: 0.7rem;
  }

  .qanswer summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    font-family: var(--font-structure);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--field);
    list-style: none;
  }

  .qanswer summary::-webkit-details-marker {
    display: none;
  }

  .qanswer summary::before {
    content: '';
    width: 0.85rem;
    height: 0.85rem;
    border: var(--rule-hair) solid currentColor;
    display: inline-block;
  }

  .qanswer[open] summary::before {
    background: currentColor;
  }

  .qanswer:not([open]) .lbl-hide,
  .qanswer[open] .lbl-show {
    display: none;
  }

  .qanswer-body {
    /* the seal lifting: the sheet swings down from its top edge */
    transform-origin: top center;
    animation: lift 260ms cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 0.6rem;
  }

  @keyframes lift {
    from {
      opacity: 0;
      transform: rotateX(-16deg) translateY(-0.3rem);
    }
  }

  .qanswer-body p {
    margin: 0;
    max-width: var(--measure);
  }

  .qanswer-body .field-label {
    display: block;
    margin-bottom: 0.15rem;
  }

  .qnote {
    margin-top: 0.5rem !important;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .qanswer-none {
    border-top: var(--rule-hair) dashed var(--rule);
    padding-top: 0.7rem;
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  @media (max-width: 40rem) {
    .qdiff {
      margin-left: 0;
    }
  }
</style>
