---
import { CORPUS } from '../lib/corpus.js';

const { q, headingLevel = 'h3', linked = true, open = false } = Astro.props;

const Heading = headingLevel;
const OPTIONS = ['a', 'b', 'c', 'd'];
const href = `/upsc/question/${q.slug}`;
---

<article class="qblock">
  <div class="qhead">
    <span class="serial qref">
      {q.year} · Q{q.q_no}
    </span>
    <a class="qsubject" href={`/upsc/subject/${q.subjectSlug}`}>{q.subject}</a>
    <span class="qsep" aria-hidden="true">›</span>
    <a class="qsubtopic" href={`/upsc/topic/${q.subjectSlug}/${q.subtopicSlug}`}>{q.subtopic}</a>
    <span class={`qdiff qdiff-${q.difficulty}`}>{q.difficulty}</span>
    {q.status === 'cancelled' && <span class="qflag">Cancelled by UPSC</span>}
    {q.status === 'disputed' && <span class="qflag qflag-warn">Answer disputed</span>}
  </div>

  <Heading class="qtext">
    {linked ? <a href={href}>{q.question}</a> : q.question}
  </Heading>

  <ol class="qopts">
    {
      OPTIONS.map((key) => (
        <li class={q.answer === key ? 'is-answer' : ''}>
          <span class="serial qopt-key">({key})</span>
          <span class="qopt-text">{q[key]}</span>
        </li>
      ))
    }
  </ol>

  {
    q.answer ? (
      <details class="qanswer" open={open}>
        <summary>
          <span class="lbl-show">Show answer</span>
          <span class="lbl-hide">Hide answer</span>
        </summary>
        <div class="qanswer-body">
          <p>
            <span class="field-label">Official answer</span>
            <strong class="serial">({q.answer})</strong> {q[q.answer]}
          </p>
          {q.answer_note && <p class="qnote">{q.answer_note}</p>}
        </div>
      </details>
    ) : (
      <p class="qanswer-none">
        No answer is recorded for this question{q.answer_note ? `: ${q.answer_note}` : '.'}
      </p>
    )
  }
</article>
