---
// Rendered only when Google sign-in is configured at build time (see
// lib/accounts/config.js), so until the owner sets PUBLIC_AUTH_PROVIDERS=google
// the built pages carry no trace of it: no markup, no script, no chunk.
import { authEnabled } from '../lib/accounts/config.js';
---

{
  authEnabled && (
    <div class="account" data-account>
      {/* Hidden until the script has looked for a session: with JS off the button
          would do nothing, and a signed-in reader would see it flash. */}
      <button type="button" class="account-btn" data-account-signin hidden>Sign in</button>
      <div class="account-user" data-account-user hidden>
        {/* A disclosure, not an ARIA menu: it shows text, links and a button,
            reached with Tab like any others, so it is announced as a button that
            expands what it controls, with no menu roles to promise arrow keys.
            The visible words "My account" are its name; on a phone they are cut
            down to the initial and the caret, and stay for a screen reader. */}
        <button type="button" class="account-btn account-toggle" data-account-toggle aria-controls="account-menu" aria-expanded="false">
          <span class="account-initial" data-account-initial></span>
          <span class="account-label">My account</span>
          <span class="account-caret" aria-hidden="true"></span>
        </button>
        <div class="account-menu" id="account-menu" data-account-menu hidden>
          <p class="account-who">Signed in as <span data-account-name></span></p>
          <a href="/account">My progress</a>
          <a href="/account#lists">My lists</a>
          <button type="button" data-account-signout>Sign out</button>
        </div>
      </div>
      <p class="account-note" data-account-note role="status" hidden></p>
    </div>
  )
}

{
  authEnabled && (
    <script>
      import '../scripts/account.js';

      // Sync is its own chunk, fetched only once someone is actually signed in.
      // A page that shows the whole account (/account, marked data-sync-full)
      // reads all of it on every visit, not only what this device changed.
      document.addEventListener('sawaalbox:signed-in', async (e) => {
        try {
          const { startSync } = await import('../scripts/sync.js');
          startSync(e.detail.client, e.detail.user, { full: document.querySelector('[data-sync-full]') !== null });
        } catch (err) {
          console.warn('SawaalBox: sync did not start', err);
        }
      });
    </script>
  )
}

<style>
  .account { position: relative; }
  /* Without scripting nothing in here can ever show: drop the empty box so it
     does not leave a stray gap in the nav. */
  @media (scripting: none) {
    .account { display: none; }
  }
  /* Sign in and the signed-in control are both served hidden and shown once
     account.js has looked for a session. Where scripts run, each one's box
     stays in the layout while it is not the one showing, invisible (and so
     neither focusable nor announced), and the two share one grid cell. The cell
     is therefore as wide as the wider of the two from first paint, so the nav
     takes its final width at once and nothing shifts, or wraps on a narrow
     phone, when Sign in or My account appears. Measured from the buttons
     themselves, so it holds for either font and any initial. The cell sits at
     its end, beside the theme toggle. */
  @media (scripting: enabled) {
    .account {
      display: grid;
      justify-items: end;
      align-items: center;
    }
    .account > [data-account-signin],
    .account > [data-account-user] {
      grid-area: 1 / 1;
    }
    .account > [data-account-signin][hidden] {
      display: block;
      visibility: hidden;
    }
    /* Sized by its button, as Sign in is, not by a line box a few pixels
       taller, so the row keeps its height when it takes Sign in's place. */
    .account > [data-account-user] {
      display: flex;
    }
    .account > [data-account-user][hidden] {
      visibility: hidden;
    }
  }
  .account-btn {
    white-space: nowrap;
    padding: 0.25rem 0.6rem;
    /* Match the theme toggle beside it (its 0.95rem icon sets its height) so
       the two outlined controls read as one pair. No display is set here: the
       hidden attribute has to keep working on these buttons. */
    min-height: calc(0.95rem + 0.5rem + 2 * var(--rule-hair));
    background: transparent;
    color: inherit;
    border: var(--rule-hair) solid currentColor;
    border-radius: 0;
    font-family: var(--font-structure);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .account-btn:hover { background: var(--field-deep); }
  /* The buttons always sit on the green masthead, where the sitewide green
     focus ring would vanish into the field. */
  .account-btn:focus-visible { outline-color: var(--field-ink); }
  .account-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  /* The serial face, as for every letter that stands for something. A fixed
     minimum so a wide letter does not change the control's width. */
  .account-initial {
    min-width: 1.1rem;
    text-align: center;
    font-family: var(--font-serial);
    font-weight: 700;
  }
  /* The disclosure caret, drawn: two borders of a square turned a quarter. A
     character would be a glyph icon, and DESIGN.md draws its icons. It turns
     over while the panel is open. */
  .account-caret {
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    border-right: var(--rule-heavy) solid currentColor;
    border-bottom: var(--rule-heavy) solid currentColor;
    transform: translateY(-0.15rem) rotate(45deg);
  }
  .account-toggle[aria-expanded='true'] .account-caret {
    transform: translateY(0.1rem) rotate(-135deg);
  }
  /* Where the row is short, the words give way to the initial and the caret.
     Visually hidden, not display: none, so the button keeps its name. The
     breakpoint is measured: the exam masthead (wordmark, Subjects, Years,
     Search, My progress, this control, the theme toggle) is the widest header
     and needs 782px to stay on one row with the words showing. 50rem is 800px,
     which leaves room for a desktop scrollbar (a media query counts it, the
     layout does not), so the words show only where that row fits. */
  @media (max-width: 50rem) {
    .account-label {
      position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
    }
  }
  .account-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 10;
    display: grid;
    min-width: 13rem;
    max-width: min(20rem, calc(100vw - 1rem));
    background: var(--paper);
    color: var(--ink);
    border: var(--rule-heavy) solid var(--rule-strong);
  }
  /* display: grid above would otherwise win over the hidden attribute. */
  .account-menu[hidden] { display: none; }
  .account-menu a,
  .account-menu button {
    padding: 0.6rem 0.8rem;
    text-align: left;
    font: 600 0.88rem var(--font-structure);
    color: inherit;
    background: none;
    border: 0;
    text-decoration: none;
    cursor: pointer;
  }
  .account-menu > * + * { border-top: var(--rule-hair) solid var(--rule); }
  /* Who is signed in: plain text, not a control, so it is set in soft ink with
     the name picked out. A long name or an address wraps rather than widening
     the panel. */
  .account-who {
    margin: 0;
    max-width: none;
    padding: 0.6rem 0.8rem;
    font: 400 0.8rem/1.4 var(--font-structure);
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }
  .account-who [data-account-name] { color: var(--ink); font-weight: 700; }
  .account-menu a:hover,
  .account-menu button:hover { background: var(--ground); }
  /* Sign out while the last sync runs (account.js): it says "Signing out…"
     and takes no second press, so it stops looking pressable. */
  .account-menu button[aria-disabled='true'] {
    cursor: progress;
    color: var(--ink-soft);
    background: none;
  }
  .account-note {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 10;
    width: min(18rem, 80vw);
    margin: 0;
    padding: 0.6rem 0.8rem;
    background: var(--paper);
    color: var(--ink);
    border: var(--rule-heavy) solid var(--rule-strong);
    font-size: 0.85rem;
  }
  /* On a phone the control sits a long way from the right edge, so a note
     anchored to it would run off the left of the screen. Pin it to the
     viewport instead; account.js sets --account-note-top to just under the
     control. */
  @media (max-width: 40rem) {
    .account-note {
      position: fixed;
      inset-inline: 1rem;
      width: auto;
      top: var(--account-note-top, 1rem);
    }
  }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
</style>
