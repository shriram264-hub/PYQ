---
import ThemeToggle from './ThemeToggle.astro';
import AccountControl from './AccountControl.astro';
import { examForPath, withExamCrumb } from '../lib/exams.js';

const crumbs = withExamCrumb(Astro.url.pathname, Astro.props.crumbs ?? []);
// The masthead sits inside an exam's booklet, so its sections are that exam's.
const exam = examForPath(Astro.url.pathname);
// The progress page is not an exam page, so no exam link ever marks it; this
// link does when you are on it.
const onProgress = Astro.url.pathname === '/account';
---

<header class="masthead">
  <div class:list={['sheet', 'masthead-inner', { 'has-exam': exam }]}>
    <a class="wordmark" href="/">
      <span class="wordmark-latin">SawaalBox</span>
      <span class="wordmark-deva" lang="hi">सवाल बॉक्स</span>
    </a>
    <nav class="masthead-nav" aria-label="Sections">
      {
        exam && (
          <>
            <a href={`${exam.path}/subjects`}>Subjects</a>
            <a href={`${exam.path}/years`}>Years</a>
            <a href={`${exam.path}/search`}>Search</a>
          </>
        )
      }
      <a href="/account" class="nav-progress" aria-current={onProgress ? 'page' : undefined}>My progress</a>
    </nav>
    {/* Beside the nav, not in it: they are controls, not sections, and on a
        phone they sit on the wordmark's row while the links take the row below. */}
    <div class="masthead-tools">
      <AccountControl />
      <ThemeToggle />
    </div>
  </div>
  {
    crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol class="sheet crumbs-inner">
          {crumbs.map((crumb, i) => (
            <li>
              {i < crumbs.length - 1 ? (
                <a href={crumb.href}>{crumb.name}</a>
              ) : (
                <span aria-current="page">{crumb.name}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )
  }
</header>

<style>
  .masthead {
    background: var(--field);
    color: var(--field-ink);
    border-bottom: var(--rule-heavy) solid var(--rule-strong);
  }

  .masthead-inner {
    display: flex;
    align-items: baseline;
    gap: 1rem 1.2rem;
    flex-wrap: wrap;
    padding-block: 0.9rem;
  }

  .wordmark {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
  }

  .wordmark-latin {
    font-family: var(--font-structure);
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: -0.035em;
  }

  .wordmark-deva {
    font-size: 0.95rem;
    color: var(--field-ink-soft);
  }

  .masthead-nav {
    /* Pushes the nav and the controls after it to the right, as the space
       between did when the nav held them. */
    margin-left: auto;
    display: flex;
    /* Wraps if the links alone are wider than the sheet. */
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    font-family: var(--font-structure);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .masthead-nav a {
    text-decoration-color: transparent;
    white-space: nowrap;
  }

  .masthead-nav a:hover,
  .masthead-nav a[aria-current='page'] {
    text-decoration-color: currentColor;
  }

  .masthead-tools {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  /* Wordmark, four links and both controls need about 780px to share one row.
     Narrower than that, inside an exam, the controls move up beside the
     wordmark and the links take a row of their own below: two rows, as before
     My progress joined, where one flowing row would leave the controls alone on
     a third. Outside an exam the nav is only My progress, which flows on
     beside the wordmark until a phone's width (below). 50rem is 800px, the same
     line at which the account control drops its words. */
  @media (max-width: 50rem) {
    .masthead-inner {
      gap: 0.6rem 0.75rem;
    }

    .masthead-tools {
      gap: 0.75rem;
    }

    .has-exam .masthead-tools {
      order: 2;
      margin-left: auto;
    }

    .has-exam .masthead-nav {
      order: 3;
      flex-basis: 100%;
      margin-left: 0;
    }
  }

  /* Wordmark, My progress and both controls need about 440px. On a narrower
     phone every page takes the same two rows: the controls beside the
     wordmark, the links below. */
  @media (max-width: 27.5rem) {
    .masthead-tools {
      order: 2;
      margin-left: auto;
    }

    .masthead-nav {
      order: 3;
      flex-basis: 100%;
      margin-left: 0;
    }
  }

  .crumbs {
    background: var(--field-deep);
    border-top: var(--rule-hair) solid var(--field-rule);
  }

  .crumbs-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding-block: 0.5rem;
    font-family: var(--font-structure);
    font-size: 0.78rem;
    color: var(--field-ink-soft);
  }

  .crumbs-inner li + li::before {
    content: '/';
    margin-right: 0.4rem;
    opacity: 0.55;
  }

  .crumbs-inner [aria-current='page'] {
    color: var(--field-ink);
  }
</style>
