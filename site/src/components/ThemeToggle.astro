---
// Three states, cycled in this order: follow the system, force light, force dark.
// "System" is the default so a reader who never touches this keeps whatever
// their device already decided.
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-live="polite"
  title="Change theme"
>
  <svg class="tt-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <g class="i-system"><circle cx="8" cy="8" r="5.5" /><path d="M8 2.5v11a5.5 5.5 0 0 0 0-11z" class="fill" /></g>
    <g class="i-light"><circle cx="8" cy="8" r="3" /><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M3.05 12.95l1.4-1.4M11.55 4.45l1.4-1.4" /></g>
    <g class="i-dark"><path d="M13.2 10.1A5.5 5.5 0 0 1 5.9 2.8a5.5 5.5 0 1 0 7.3 7.3z" /></g>
  </svg>
  <span class="tt-text">Theme</span>
</button>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    const ORDER = ['system', 'light', 'dark'];
    const LABEL = { system: 'System', light: 'Light', dark: 'Dark' };

    const read = () => {
      try {
        return localStorage.getItem('sawaalbox-theme') || 'system';
      } catch {
        return 'system';
      }
    };

    function paint(choice) {
      const root = document.documentElement;
      if (choice === 'system') root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', choice);

      btn.dataset.choice = choice;
      btn.querySelector('.tt-text').textContent = LABEL[choice];
      btn.setAttribute('aria-label', `Theme: ${LABEL[choice]}. Click to change.`);
    }

    paint(read());

    btn.addEventListener('click', () => {
      const next = ORDER[(ORDER.indexOf(read()) + 1) % ORDER.length];
      try {
        next === 'system'
          ? localStorage.removeItem('sawaalbox-theme')
          : localStorage.setItem('sawaalbox-theme', next);
      } catch {
        /* private mode: the choice still applies for this page */
      }
      paint(next);
    });
  })();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    background: transparent;
    color: inherit;
    border: var(--rule-hair) solid currentColor;
    border-radius: 0;
    font-family: var(--font-structure);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    opacity: 0.85;
  }

  .theme-toggle:hover {
    opacity: 1;
  }

  .tt-icon {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .tt-icon .fill {
    fill: currentColor;
    stroke: none;
  }

  .tt-icon g {
    display: none;
  }

  .theme-toggle[data-choice='system'] .i-system,
  .theme-toggle[data-choice='light'] .i-light,
  .theme-toggle[data-choice='dark'] .i-dark {
    display: inline;
  }

  @media (max-width: 30rem) {
    .tt-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
